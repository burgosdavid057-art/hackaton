# Secretos — nunca al repositorio
.env
*.key

# Datos: catalog.json y manuals/ SÍ se versionan (son la base del RAG y no
# necesitan llaves para funcionar con Ollama + BM25). index/ y chroma/ se
# regeneran con build_index.py + build_vectordb.py (solo mejoran el RAG si hay
# llave de Gemini para los embeddings).
data/index/
data/chroma/

# Base del Copiloto de Producción: se regenera con produccion/db.py
# (inicializar() + reprocesar el inbox). Contiene datos de planta, no va al repo.
# Los archivos -wal y -shm son del journal WAL que abre db.conectar().
data/produccion.db
data/produccion.db-wal
data/produccion.db-shm
data/chroma_produccion/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Logs y temporales
*.log
_run_*.py
evals/resultados.json
evals_produccion/resultados.json
data/eval_produccion.db

# Reportes de turno que suelte el supervisor: son datos internos de planta.
# El .gitkeep mantiene la carpeta en el repo, el contenido no.
produccion/inbox/*
!produccion/inbox/.gitkeep

# WhatsApp bot (open-wa)
whatsapp-bot/node_modules/
whatsapp-bot/qr.png
whatsapp-bot/.wwebjs_auth/
whatsapp-bot/_IGNORE_*/
whatsapp-bot/session*.data.json

# managed
**.data.json
**.node-persist**
**_IGNORE_**
# end managed
